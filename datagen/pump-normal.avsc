{
  "type": "record",
  "name": "PumpTelemetry",
  "namespace": "pertamina.upstream.pdm",
  "doc": "Kondisi normal 6 aset",
  "fields": [
    {
      "name": "asset_id",
      "doc": "ID aset (contoh)",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": [
            "ESP-WLA-01",
            "ESP-WLA-02",
            "ESP-WLA-03",
            "ESP-WLB-01",
            "CMP-JMB-01",
            "CMP-JMB-02"
          ]
        }
      }
    },
    {
      "name": "vibration_rms_mm_s",
      "doc": "Getaran RMS, mm/s",
      "type": {
        "type": "double",
        "arg.properties": {
          "range": {
            "min": 2.0,
            "max": 3.2
          }
        }
      }
    },
    {
      "name": "bearing_temp_c",
      "doc": "Suhu bearing, derajat C",
      "type": {
        "type": "double",
        "arg.properties": {
          "range": {
            "min": 68.0,
            "max": 78.0
          }
        }
      }
    },
    {
      "name": "motor_current_a",
      "doc": "Arus motor, ampere",
      "type": {
        "type": "double",
        "arg.properties": {
          "range": {
            "min": 38.0,
            "max": 46.0
          }
        }
      }
    },
    {
      "name": "discharge_pressure_bar",
      "doc": "Tekanan discharge, bar",
      "type": {
        "type": "double",
        "arg.properties": {
          "range": {
            "min": 95.0,
            "max": 110.0
          }
        }
      }
    },
    {
      "name": "pump_status",
      "doc": "Status pompa",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": [
            "RUNNING"
          ]
        }
      }
    },
    {
      "name": "scenario",
      "doc": "Penanda skenario Datagen, untuk demo",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": [
            "normal"
          ]
        }
      }
    }
  ]
}
