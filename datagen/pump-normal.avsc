{
  "type": "record",
  "name": "PumpTelemetry",
  "namespace": "pertamina.upstream.pdm",
  "doc": "Kondisi normal 6 aset",
  "fields": [
    {
      "name": "asset_id",
      "type": "string",
      "doc": "ID aset (contoh)",
      "arg.properties": {
        "options": [
          "ESP-WLA-01",
          "ESP-WLA-02",
          "ESP-WLA-03",
          "ESP-WLB-01",
          "CMP-JMB-01",
          "CMP-JMB-02"
        ]
      }
    },
    {
      "name": "vibration_rms_mm_s",
      "type": "double",
      "doc": "Getaran RMS, mm/s",
      "arg.properties": {
        "range": {
          "min": 2.0,
          "max": 3.2
        }
      }
    },
    {
      "name": "bearing_temp_c",
      "type": "double",
      "doc": "Suhu bearing, derajat C",
      "arg.properties": {
        "range": {
          "min": 68.0,
          "max": 78.0
        }
      }
    },
    {
      "name": "motor_current_a",
      "type": "double",
      "doc": "Arus motor, ampere",
      "arg.properties": {
        "range": {
          "min": 38.0,
          "max": 46.0
        }
      }
    },
    {
      "name": "discharge_pressure_bar",
      "type": "double",
      "doc": "Tekanan discharge, bar",
      "arg.properties": {
        "range": {
          "min": 95.0,
          "max": 110.0
        }
      }
    },
    {
      "name": "pump_status",
      "type": "string",
      "arg.properties": {
        "options": [
          "RUNNING"
        ]
      }
    },
    {
      "name": "scenario",
      "type": "string",
      "doc": "Penanda skenario Datagen, untuk demo",
      "arg.properties": {
        "options": [
          "normal"
        ]
      }
    }
  ]
}
