{
  "type": "record",
  "name": "PumpTelemetry",
  "namespace": "pertamina.upstream.pdm",
  "doc": "Kerusakan berat pada ESP-WLA-02",
  "fields": [
    {
      "name": "asset_id",
      "type": "string",
      "doc": "ID aset (contoh)",
      "arg.properties": {
        "options": [
          "ESP-WLA-02"
        ]
      }
    },
    {
      "name": "vibration_rms_mm_s",
      "type": "double",
      "doc": "Getaran RMS, mm/s",
      "arg.properties": {
        "range": {
          "min": 6.5,
          "max": 9.0
        }
      }
    },
    {
      "name": "bearing_temp_c",
      "type": "double",
      "doc": "Suhu bearing, derajat C",
      "arg.properties": {
        "range": {
          "min": 90.0,
          "max": 100.0
        }
      }
    },
    {
      "name": "motor_current_a",
      "type": "double",
      "doc": "Arus motor, ampere",
      "arg.properties": {
        "range": {
          "min": 52.0,
          "max": 58.0
        }
      }
    },
    {
      "name": "discharge_pressure_bar",
      "type": "double",
      "doc": "Tekanan discharge, bar",
      "arg.properties": {
        "range": {
          "min": 75.0,
          "max": 88.0
        }
      }
    },
    {
      "name": "pump_status",
      "type": "string",
      "arg.properties": {
        "options": [
          "RUNNING"
        ]
      }
    },
    {
      "name": "scenario",
      "type": "string",
      "doc": "Penanda skenario Datagen, untuk demo",
      "arg.properties": {
        "options": [
          "gagal"
        ]
      }
    }
  ]
}
